local PetDropdown = PetTab:CreateDropdown({
   Name = "Select Pets to Feed:",
   Options = {"Scan Pets first"},
   MultipleOptions = true,
   -- Không đặt Flag ở đây vì danh sách Pet thay đổi theo server/lần chơi
   Callback = function(Options) _G.SelectedPets = Options end,
})

PetTab:CreateButton({
   Name = "SCAN PETS & UPDATE ESP",
   Callback = function()
       local list = {}
       _G.PetLookupTable = {}
       for _, v in pairs(_G.ESPCache) do if v then v:Destroy() end end
       _G.ESPCache = {}

       for _, obj in pairs(game.Workspace:GetDescendants()) do
           if obj:IsA("Model") and string.match(obj.Name, "%w%w%w%w%w%w%w%w%-") then
               local fullID = obj.Name 
               local species = obj:GetAttribute("Species") or "Pet"
               local shortID = string.sub(fullID, -5)
               local displayName = species .. " [#" .. shortID .. "]"
               
               _G.PetLookupTable[displayName] = fullID
               table.insert(list, displayName)
               
               local bbg = Instance.new("BillboardGui")
               bbg.Parent = obj
               bbg.Adornee = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
               bbg.Size = UDim2.new(0, 80, 0, 30)
               bbg.StudsOffset = Vector3.new(0, 3, 0)
               bbg.AlwaysOnTop = true
               bbg.Enabled = _G.ESPEnabled
               
               local txt = Instance.new("TextLabel", bbg)
               txt.Size = UDim2.new(1, 0, 1, 0)
               txt.BackgroundTransparency = 1
               txt.TextColor3 = Color3.fromRGB(0, 255, 255)
               txt.TextStrokeTransparency = 0
               txt.Text = "ID: " .. shortID
               txt.Font = Enum.Font.GothamBold
               txt.TextSize = 12
               
               table.insert(_G.ESPCache, bbg)
           end
       end
       PetDropdown:Refresh(list)
   end,
})

local currentPetIndex = 1

PetTab:CreateToggle({
   Name = "Enable Auto Feed (Cycle Only)",
   CurrentValue = false,
   Flag = "Toggle_AutoFeed", -- LƯU CÀI ĐẶT
   Callback = function(Value)
      _G.AutoFeed = Value
      task.spawn(function()
          while _G.AutoFeed do
              local selected = _G.SelectedPets or {}
              
              if #selected > 0 then
                  if currentPetIndex > #selected then
                      currentPetIndex = 1
                  end
                  
                  local pName = selected[currentPetIndex]
                  local id = _G.PetLookupTable[pName]
                  
                  if id then
                      pcall(function() 
                          petRemote:FireServer("Feed", id, _G.SelectedTreat) 
                      end)
                      
                      currentPetIndex = currentPetIndex + 1
                  end
                  
                  task.wait(1.2)
              else
                  task.wait(1)
              end
          end
      end)
   end,
})

