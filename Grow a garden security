SettingTab:CreateSlider({
   Name = "JumpPower",
   Range = {50, 500},
   Increment = 1,
   Suffix = "Power",
   CurrentValue = 50,
   Callback = function(Value) 
       player.Character.Humanoid.UseJumpPower = true
       player.Character.Humanoid.JumpPower = Value 
   end,
})

SettingTab:CreateSection("MOVEMENT")
SettingTab:CreateToggle({
   Name = "Fly (Bay)",
   CurrentValue = false,
   Callback = function(Value)
       _G.FlyEnabled = Value
       if Value then
           local char = player.Character
           local root = char:FindFirstChild("HumanoidRootPart")
           local camera = workspace.CurrentCamera
           task.spawn(function()
               local bv = Instance.new("BodyVelocity", root)
               bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
               bv.Velocity = Vector3.new(0,0,0)
               while _G.FlyEnabled do
                   local moveDir = char.Humanoid.MoveDirection
                   bv.Velocity = (camera.CFrame.LookVector * (moveDir.Magnitude > 0 and _G.FlySpeed or 0)) + Vector3.new(0, 0.1, 0)
                   task.wait()
               end
               bv:Destroy()
           end)
       end
   end,
})

SettingTab:CreateSlider({
   Name = "Fly Speed",
   Range = {10, 300},
   Increment = 5,
   Suffix = "Speed",
   CurrentValue = 50,
   Callback = function(Value) _G.FlySpeed = Value end,
